{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailEvent",
  "type": "object",
  "required": [
    "email_id",
    "application_id",
    "classification",
    "confidence",
    "received_at"
  ],
  "properties": {
    "email_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "APPLICATION_CONFIRMATION",
        "ASSESSMENT",
        "INTERVIEW",
        "PHONE_SCREEN",
        "INFORMATION_REQUEST",
        "REJECTION",
        "OFFER",
        "GENERAL_UPDATE",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "received_at": {
      "type": "string"
    },
    "review": {
      "type": "string"
    }
  }
}